# Normalize line endings for Godot text resources.
* text=auto eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.md text eol=lf

# Binary assets must not be merged as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.wav binary
*.ogg binary
*.mp3 binary
*.glb binary
*.blend binary
*.ttf binary
*.otf binary
